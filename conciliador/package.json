{
  "name": "conciliador-dominio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Conciliação contábil automática para o Domínio Web: lê razão e extratos, concilia e gera o TXT de importação.",
  "scripts": {
    "executar": "tsx src/cli.ts",
    "vigiar": "tsx src/cli.ts --vigiar 15",
    "mcp": "tsx src/mcp.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2"
  }
}
